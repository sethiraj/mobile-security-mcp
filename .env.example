# Copy to .env and change both secrets.
# MobSF REST API key, shared by both containers (any long random string).
MOBSF_API_KEY=change-me-to-a-long-random-string
# Bearer token MCP clients must send to http://localhost:8080/mcp
MCP_AUTH_TOKEN=change-me-too

# Optional
MOBSF_TAG=latest
MCP_IMAGE=sure4docker/mobsf-mcp:latest
MCP_TRANSPORT=http
# Android device for dynamic analysis (M6), e.g. host.docker.internal:5555
MOBSF_ANALYZER_IDENTIFIER=

# App index (MobSF has no "scans for this app" API, so it is built by paging /api/v1/scans)
MCP_SCAN_INDEX_CACHE_TTL=60s
MCP_SCAN_INDEX_MAX_SCANS=2000

# Retention (prune_scans is manual and dry-run by default)
MCP_RETENTION_ENABLED=true
MCP_RETENTION_KEEP_PER_APP=5
MCP_RETENTION_MAX_AGE_DAYS=0
